# Which venue CHARTER executes real orders against.
# testnet     -> https://testnet.binance.vision (real matching engine, zero cost, no OAuth)
# mainnet-mcp -> https://agent.binance.com/mcp/agentic (real funds, real Agent OS MCP server)
EXECUTION_VENUE=testnet

# Testnet: get these from https://testnet.binance.vision after GitHub login.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision

# Mainnet MCP: only needed once real funds and MCP OAuth are in play.
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic
# OAuth token is obtained interactively and persisted to data/mcp-token.json. No static secret here.

# Mandate compiler: optional, falls back to manual JSON editing if unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local API server.
CHARTER_API_PORT=4477
# Leave blank for local development. Set this before exposing the API on a
# public host, since every request then needs a matching X-Charter-Api-Key header.
CHARTER_API_KEY=

# Audit log.
CHARTER_AUDIT_LOG_PATH=./data/audit.log.jsonl
CHARTER_MANDATES_DIR=./data/mandates
